{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plugin Manifest",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "description",
    "category",
    "operations",
    "capabilities",
    "file_extensions",
    "entry_point"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "category": {
      "type": "string"
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "file_extensions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entry_point": {
      "type": "string"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "active",
        "disabled",
        "deprecated"
      ]
    },
    "trust": {
      "enum": [
        "trusted",
        "untrusted"
      ]
    }
  },
  "additionalProperties": true
}
