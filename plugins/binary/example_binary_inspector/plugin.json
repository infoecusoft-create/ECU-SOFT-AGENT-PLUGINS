{
  "id": "example.binary.inspector",
  "name": "Example Binary Inspector",
  "version": "1.0.0",
  "description": "Read-only demonstration plugin that reports file size and SHA-256 for binary files. It does not modify input files.",
  "category": "binary",
  "status": "active",
  "trust": "untrusted",
  "operations": [
    "inspect_binary"
  ],
  "capabilities": [
    "binary_reading",
    "file_metadata"
  ],
  "file_extensions": [
    ".bin",
    ".hex",
    ".dat"
  ],
  "input_schema": {
    "type": "object",
    "required": [
      "file_path"
    ],
    "properties": {
      "file_path": {
        "type": "string"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": [
      "size_bytes",
      "sha256"
    ]
  },
  "dependencies": [],
  "entry_point": "plugin.py",
  "permissions": [],
  "execution": {
    "mode": "in_process",
    "network": false
  },
  "safety": {
    "classification": "read_only",
    "modifies_files": false
  },
  "context": {}
}
